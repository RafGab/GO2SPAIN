# Copia este archivo como .env y rellena tu propio valor.
# Nunca subas el archivo .env real.

# Clave de administración para los endpoints con datos personales
# (GET /study-leads, GET /reviews/pending, POST /reviews/{id}/publish).
# Inventa una clave larga y guárdala en un lugar seguro.
ADMIN_KEY=

# Ruta del archivo de base de datos SQLite. En local puede quedar como
# está; en Render se apunta al disco persistente (ver render.yaml).
DATABASE_PATH=go2spain.db

# --- Aviso por correo cuando llega un formulario o una reseña nueva ---
# SMTP_USER: tu correo de Gmail.
# SMTP_PASSWORD: una "contraseña de aplicación" (no tu contraseña real),
#   generada en https://myaccount.google.com/apppasswords
#   (requiere tener activada la verificación en 2 pasos).
# NOTIFY_EMAIL: a dónde llega el aviso (si lo dejas vacío, usa SMTP_USER).
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
